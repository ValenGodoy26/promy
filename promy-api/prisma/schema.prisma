generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  COMMERCE
  ADMIN
  SUPER_ADMIN
}

enum BillingMode {
  OFF
  SCHEDULED
  ON
}

enum BillingSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingCoverageSource {
  BETA_FREE
  MERCADO_PAGO
  MANUAL
  COMPLIMENTARY
}

enum BillingPaymentSource {
  MANUAL
  MERCADO_PAGO
}

enum BillingPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  REVERSED
}

enum BillingAccessState {
  COVERED
  NO_COVERAGE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum CommerceStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BENEFIT
  TIME_SLOT
  DAY_PROMO
  SPECIAL_COMBO
}

enum PromotionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED_VISIBLE
  REJECTED
  EXPIRED
}

enum ValidationMethod {
  QR
  MANUAL_CODE
}

enum RedemptionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum PromotionAnalyticsEventType {
  IMPRESSION
  OPEN
}

enum AppNotificationType {
  REDEMPTION_VALIDATED
  REDEMPTION_CREATED
  COMMERCE_APPROVED
  COMMERCE_REJECTED
  COMMERCE_PENDING
  BILLING_SCHEDULED
  BILLING_ENFORCEMENT_ACTIVE
  BILLING_COMPLIMENTARY_GRANTED
  BILLING_MANUAL_PAYMENT_REGISTERED
  BILLING_SUSPENDED
}

enum BetaAccessPlatform {
  IPHONE
  ANDROID
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id             Int          @id @default(autoincrement())
  fullName       String
  email          String       @unique
  passwordHash   String
  birthDate      DateTime?
  country        String?
  gender         String?
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  pendingEmail   String?      @unique
  pendingEmailTokenHash String? @unique
  pendingEmailTokenExpiresAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  role           UserRole     @default(CLIENT)
  phone          String?
  status         UserStatus   @default(ACTIVE)
  sessionVersion Int          @default(0)
  sessions       Session[]
  redemptions    Redemption[]
  validatedRedemptions Redemption[] @relation("RedemptionValidator")
  notifications  AppNotification[]
  pushTokens     PushToken[]
  ownedCommerces Commerce[]   @relation("CommerceOwner")
  adminLogs      AdminActionLog[]
  registeredBillingPayments BillingPayment[] @relation("BillingPaymentRegistrar")
  billingGrantsCreated BillingCoverageGrant[] @relation("BillingGrantCreator")
  billingGrantsRevoked BillingCoverageGrant[] @relation("BillingGrantRevoker")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([role, status])
  @@index([emailVerificationExpiresAt])
  @@index([pendingEmailTokenExpiresAt])
  @@index([passwordResetExpiresAt])
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model City {
  id        Int        @id @default(autoincrement())
  name      String
  province  String
  slug      String     @unique
  isActive  Boolean    @default(true)
  commerces Commerce[]

  @@index([isActive])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  icon      String?
  isActive  Boolean    @default(true)
  commerces Commerce[]

  @@index([isActive])
}

model Commerce {
  id               Int            @id @default(autoincrement())
  ownerUserId      Int
  cityId           Int
  categoryId       Int
  name             String
  slug             String         @unique
  shortDescription String?
  description      String?
  address          String
  latitude         Float?
  longitude        Float?
  location         Unsupported("POINT") @map("location")
  phone            String?
  instagram        String?
  logoUrl          String?
  coverUrl         String?
  status           CommerceStatus @default(PENDING)
  moderationNote   String?
  isFeatured       Boolean        @default(false)
  featuredRank     Int            @default(0)
  isHiddenByAdmin  Boolean        @default(false)
  isSuspendedByAdmin Boolean      @default(false)
  adminNote        String?
  adminEditedAt    DateTime?
  adminEditedByUserId Int?
  approvedAt       DateTime?
  billingAccessState BillingAccessState @default(COVERED)
  billingCoverageUntil DateTime?
  billingSuspendedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  owner       User         @relation("CommerceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  city        City         @relation(fields: [cityId], references: [id])
  category    Category     @relation(fields: [categoryId], references: [id])
  promotions  Promotion[]
  redemptions Redemption[]
  auditLogs   AdminActionLog[]
  billingSubscription BillingSubscription?
  billingPayments BillingPayment[]
  billingCoverageGrants BillingCoverageGrant[]

  @@unique([ownerUserId])
  @@index([ownerUserId, status])
  @@index([cityId, status])
  @@index([categoryId, status])
  @@index([status, isHiddenByAdmin, billingAccessState, isFeatured, featuredRank], map: "Commerce_public_billing_idx")
  @@fulltext([name])
  @@fulltext([shortDescription])
  @@fulltext([description])
  @@fulltext([address])
  @@fulltext([shortDescription, description, address, name], map: "Commerce_catalog_fulltext_idx")
}

model Promotion {
  id             Int             @id @default(autoincrement())
  commerceId     Int
  title          String
  description    String
  promotionType  PromotionType
  validationMethod ValidationMethod @default(QR)
  discountValue  Float?
  maxRedemptions Int?
  conditions     String?
  startDate      DateTime?
  endDate        DateTime?
  startTime      String?
  endTime        String?
  imageUrl       String?
  status         PromotionStatus @default(DRAFT)
  moderationNote String?
  isFeatured     Boolean         @default(false)
  featuredRank   Int             @default(0)
  isHiddenByAdmin Boolean        @default(false)
  adminNote      String?
  adminEditedAt  DateTime?
  adminEditedByUserId Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  commerce    Commerce     @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  redemptions Redemption[]
  auditLogs   AdminActionLog[]
  schedules   PromotionSchedule[]

  @@index([commerceId, status])
  @@index([status, endDate])
  @@index([status, isHiddenByAdmin, isFeatured, featuredRank])
  @@fulltext([title])
  @@fulltext([description])
  @@fulltext([conditions])
  @@fulltext([description, conditions, title], map: "Promotion_catalog_fulltext_idx")
}

// Analytics intentionally keeps only aggregate facts and irreversible, short-lived
// deduplication keys. There are no foreign keys here: deleting a promotion or an
// account must not cascade into historical aggregate measurements.
model PromotionAnalyticsDaily {
  id          Int      @id @default(autoincrement())
  promotionId Int
  commerceId  Int
  day         DateTime @db.Date
  impressions Int      @default(0)
  opens       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([promotionId, day])
  @@index([commerceId, day])
  @@index([promotionId, day])
  @@index([day])
}

model PromotionAnalyticsReceipt {
  id          Int                        @id @default(autoincrement())
  dedupeKey   String                     @unique @db.Char(64)
  promotionId Int
  eventType   PromotionAnalyticsEventType
  createdAt   DateTime                   @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@index([promotionId, eventType])
}

model PromotionSchedule {
  id         Int      @id @default(autoincrement())
  promotionId Int
  weekday    Weekday
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, weekday])
}

model Redemption {
  id               Int              @id @default(autoincrement())
  promotionId      Int
  userId           Int?
  commerceId       Int
  validatedByUserId Int?
  validationMethod ValidationMethod
  validationCode   String?
  status           RedemptionStatus @default(PENDING)
  redeemedAt       DateTime?
  validationExpiresAt DateTime?
  failedValidationAttempts Int      @default(0)
  lastValidationAttemptAt DateTime?
  validationBlockedUntil DateTime?
  createdAt        DateTime         @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  commerce  Commerce  @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  validatedByUser User? @relation("RedemptionValidator", fields: [validatedByUserId], references: [id], onDelete: SetNull)

  @@unique([promotionId, userId])
  @@unique([validationCode])
  @@index([commerceId, status])
  @@index([userId, createdAt])
  @@index([validationCode, status])
}

model AdminActionLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int
  action      String
  targetType  String
  targetId    Int
  note        String?
  metadata    String?
  createdAt   DateTime @default(now())

  adminUser  User       @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  commerceId Int?
  commerce   Commerce?  @relation(fields: [commerceId], references: [id], onDelete: SetNull)
  promotionId Int?
  promotion  Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model BillingSettings {
  id              Int         @id @default(1)
  mode            BillingMode @default(OFF)
  billingStartsAt DateTime?
  monthlyPrice    Decimal?    @db.Decimal(12, 2)
  currency        String      @default("ARS") @db.Char(3)
  mercadoPagoPlanId String?   @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model BillingSubscription {
  id                  Int                       @id @default(autoincrement())
  commerceId          Int                       @unique
  status              BillingSubscriptionStatus @default(PENDING_PAYMENT)
  provider            String?
  providerSubscriptionId String?                @unique
  providerPlanId      String?
  providerStatus      String?
  providerExternalReference String? @unique
  providerVersion     Int?
  providerLastModifiedAt DateTime?
  reconciliationDueAt DateTime?
  enrollmentStartedAt DateTime?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  anchorDay           Int?
  paymentFailedAt     DateTime?
  graceEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean                   @default(false)
  cancelRequestedAt   DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  commerce Commerce @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  payments BillingPayment[]

  @@index([status, currentPeriodEnd])
  @@index([graceEndsAt])
  @@index([provider, reconciliationDueAt])
}

model BillingPayment {
  id                  Int                  @id @default(autoincrement())
  commerceId          Int
  subscriptionId      Int?
  source              BillingPaymentSource
  status              BillingPaymentStatus @default(PENDING)
  amount              Decimal              @db.Decimal(12, 2)
  currency            String               @default("ARS") @db.Char(3)
  periodStart         DateTime
  periodEnd           DateTime
  paidAt              DateTime?
  reference           String?
  providerPaymentId   String?              @unique
  note                String?              @db.Text
  registeredByUserId  Int?
  reversedPaymentId   Int?                  @unique
  createdAt           DateTime             @default(now())

  commerce Commerce @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  registeredByUser User? @relation("BillingPaymentRegistrar", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  reversedPayment BillingPayment? @relation("BillingPaymentReversal", fields: [reversedPaymentId], references: [id], onDelete: SetNull)
  reversalOf BillingPayment? @relation("BillingPaymentReversal")

  @@index([commerceId, status, periodEnd])
  @@index([subscriptionId, createdAt])
}

model MercadoPagoWebhookReceipt {
  id          Int      @id @default(autoincrement())
  fingerprint String   @unique @db.Char(64)
  topic       String
  resourceId  String
  status      String   @default("RECEIVED")
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  errorCode   String?

  @@index([topic, resourceId])
  @@index([status, receivedAt])
}

model BillingCoverageGrant {
  id                Int                   @id @default(autoincrement())
  commerceId        Int
  source            BillingCoverageSource @default(COMPLIMENTARY)
  startsAt          DateTime
  endsAt            DateTime?
  reason            String?               @db.Text
  createdByUserId   Int
  revokedAt         DateTime?
  revokedByUserId   Int?
  createdAt         DateTime              @default(now())

  commerce Commerce @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  createdByUser User @relation("BillingGrantCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("BillingGrantRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([commerceId, source, startsAt, endsAt])
  @@index([endsAt, revokedAt])
}

model AppNotification {
  id        Int                 @id @default(autoincrement())
  userId    Int
  type      AppNotificationType
  title     String
  body      String
  data      String?             @db.Text
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
}

model PushToken {
  id               Int      @id @default(autoincrement())
  userId           Int
  token            String   @unique
  platform         String
  deviceLabel      String?
  isActive         Boolean  @default(true)
  lastRegisteredAt DateTime @default(now())
  lastSentAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model BetaAccessRequest {
  id        Int                @id @default(autoincrement())
  email     String
  city      String?
  platform  BetaAccessPlatform
  source    String             @default("landing")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([email, platform])
  @@index([platform, createdAt])
}
