# PROMY API - Variables de entorno
# Copia este archivo a .env y completa los valores reales.

PORT=4000
APP_ENV=development
NODE_ENV=development

# Directo (default seguro): no confia en Forwarded/X-Forwarded-*.
# Detras de proxy: lista explicita de alias, IP o CIDR; nunca cantidad de saltos.
# Ejemplos: TRUST_PROXY=loopback o TRUST_PROXY=10.0.0.10,10.0.1.0/24
TRUST_PROXY=none

# Para cookies httpOnly en web, usa origenes explicitos.
# Local real recomendado:
# CORS_ORIGIN=http://192.168.1.4:5173,http://192.168.1.4:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Produccion:
# CORS_ORIGIN=https://promy-web.vercel.app,https://promy.com
CORS_ORIGIN=http://192.168.1.4:5173,http://192.168.1.4:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PUBLIC_WEB_URL=http://192.168.1.4:5173
PUBLIC_API_BASE_URL=http://192.168.1.4:4000
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Genera secretos reales con al menos 32 caracteres aleatorios.
# Ejemplo PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=promy-local-jwt-s3cret-9f84k2m1q7r6x5a4
JWT_REFRESH_SECRET=promy-local-refresh-s3cret-8d73j1n2p4q6w9
REFRESH_COOKIE_NAME=promy_refresh_token
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDEMPTION_VALIDATION_BLOCK_MINUTES=60

# Emails transaccionales
# development local: AUTH_EMAIL_PROVIDER=console
# integration automatizada: AUTH_EMAIL_PROVIDER=test (solo valido con APP_ENV=test)
# produccion: AUTH_EMAIL_PROVIDER=resend
# produccion: AUTH_EMAIL_FROM="PROMY <no-reply@promy.app>"
# produccion: RESEND_API_KEY=re_xxxxxxxxxxxxx
AUTH_EMAIL_PROVIDER=console
AUTH_EMAIL_FROM="PROMY <no-reply@promy.app>"
# AUTH_EMAIL_REPLY_TO=soporte@promy.app
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Uploads / imagenes
# local: sirve /uploads desde este backend
# s3: sube las imagenes a Cloudflare R2, AWS S3 u otro storage compatible
UPLOADS_DRIVER=local
# UPLOADS_PUBLIC_BASE_URL=https://cdn.promy.app
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=promy-uploads
# S3_ACCESS_KEY_ID=xxxxxxxxxxxxx
# S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxx

# MySQL local
DATABASE_URL="mysql://root:@localhost:3306/promy_db"
