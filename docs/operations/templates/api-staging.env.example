# Template de provisionamiento para staging. No copiar secretos al repositorio ni al artifact.
# Staging usa la semántica estricta de production, pero con hosts, DB, buckets y proyectos separados.
APP_ENV=production
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
PROMOTION_TIMEZONE=America/Argentina/Buenos_Aires

# Obligatorio: IP/CIDR reales del reverse proxy. Nunca none, *, booleanos ni cantidad de saltos.
TRUST_PROXY=<STAGING_PROXY_IP_OR_CIDR>
# Obligatorio: orígenes HTTPS exactos y separados por coma. Nunca *.
CORS_ORIGIN=https://<STAGING_WEB_HOST>,https://<STAGING_LANDING_HOST>
PUBLIC_WEB_URL=https://<STAGING_WEB_HOST>
PUBLIC_API_BASE_URL=https://<STAGING_API_HOST>

# Obligatorio, secreto externo. MySQL aislado de staging; nunca usar una DB local o productiva.
DATABASE_URL=mysql://<STAGING_DB_USER>:<REQUIRED_SECRET>@<STAGING_DB_HOST>:3306/<STAGING_DB_NAME>
JWT_SECRET=<REQUIRED_SECRET>
JWT_REFRESH_SECRET=<REQUIRED_SECRET>
REFRESH_COOKIE_NAME=promy_refresh_token
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Fail-closed: dejar 0 hasta que exista contacto de privacidad oficial aprobado.
PUBLIC_REGISTRATION_ENABLED=0
# Obligatorio sólo si PUBLIC_REGISTRATION_ENABLED=1.
PRIVACY_CONTACT_EMAIL=<STAGING_PRIVACY_CONTACT_EMAIL>

# Obligatorio para emails reales. Proveedor externo: validar entrega únicamente con buzones QA.
AUTH_EMAIL_PROVIDER=resend
AUTH_EMAIL_FROM=PROMY <no-reply@<STAGING_EMAIL_DOMAIN>>
AUTH_EMAIL_REPLY_TO=<STAGING_SUPPORT_EMAIL>
RESEND_API_KEY=<REQUIRED_SECRET>

# Opcional: sin REDIS_URL se conserva el fallback de cache en memoria y no se habilitan múltiples réplicas SSE.
REDIS_URL=
REDIS_KEY_PREFIX=promy:staging:cache:

# Elegir una sola opción. local exige volumen persistente, backup y URL pública controlada por la API.
UPLOADS_DRIVER=s3
UPLOADS_PUBLIC_BASE_URL=https://<STAGING_UPLOADS_HOST>
S3_ENDPOINT=https://<STAGING_S3_ENDPOINT_HOST>
S3_REGION=auto
S3_BUCKET=<STAGING_S3_BUCKET>
S3_ACCESS_KEY_ID=<REQUIRED_SECRET>
S3_SECRET_ACCESS_KEY=<REQUIRED_SECRET>

# Opcional, proveedor externo. No habilita alertas hasta configurar proyecto/canal reales.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=<RELEASE_SHA>
SENTRY_TRACES_SAMPLE_RATE=0

# Opcional: push real requiere su propio proyecto Expo y token externo.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
REDEMPTION_CODE_TTL_MINUTES=20
REDEMPTION_MAX_FAILED_ATTEMPTS=5
REDEMPTION_VALIDATION_BLOCK_MINUTES=60
