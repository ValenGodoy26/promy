# PROMY MOBILE - Variables de entorno
# Modo local real recomendado: URL explicita a la API host.

EXPO_PUBLIC_API_URL=http://192.168.1.4:4000/api

# Expo Push Project ID
# Obligatorio para notificaciones push reales y builds EAS.
# EXPO_PUBLIC_EXPO_PROJECT_ID=tu-project-id-de-expo

# Sentry
# Activa observabilidad de errores en mobile cuando tengas un proyecto configurado.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxx.ingest.sentry.io/xxxxx
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# EXPO_PUBLIC_SENTRY_RELEASE=promy-mobile@1.0.0
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
