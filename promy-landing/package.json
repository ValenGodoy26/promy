{
  "name": "promy-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "test": "node --experimental-strip-types --test tests/public-stats.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build --mode release --configLoader runner",
    "preview": "vite preview",
    "build:local": "tsc -b && vite build --configLoader runner",
    "qa:local": "npm run test && npm run typecheck && npm run build:local",
    "cleanup:legacy-assets": "node scripts/cleanup-legacy-assets.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
