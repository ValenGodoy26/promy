# Configuración pública para compilar la Landing en modo release.
# Todas las variables VITE_* quedan incluidas en el bundle cliente: no usar secretos.

# API pública HTTPS usada por la Landing.
VITE_API_BASE_URL=

# URL pública HTTPS del panel de comercios.
VITE_PANEL_BASE_URL=

# Información legal/pública obligatoria antes de un release.
VITE_LEGAL_RESPONSIBLE=
VITE_LEGAL_ADDRESS=
VITE_RETENTION_POLICY=
VITE_PRIVACY_EMAIL=
VITE_SUPPORT_EMAIL=
VITE_COMPLAINTS_EMAIL=

# Establecer en true únicamente después de la revisión humana/jurídica final.
VITE_LEGAL_REVIEWED=false
